# Copy to .env.local and fill in what you need.

# Claude picks the best moments and finds the speaker for cropping.
# Without a key the app still works using a built-in (non-AI) moment picker.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max

# Where jobs and rendered clips are stored.
# DATA_DIR=./data

# Tool locations, if not on PATH.
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# If YouTube says "Sign in to confirm you're not a bot", export your browser
# cookies to a cookies.txt file and point to it here.
# YTDLP_COOKIES=./cookies.txt
# YTDLP_EXTRA_ARGS=

# Set to 1 to download the whole video instead of only the clip sections.
# FULL_DOWNLOAD=0
# MAX_VIDEO_SECONDS=14400
# MAX_CONCURRENT_JOBS=1

# Rendering
# X264_PRESET=veryfast        # slower = smaller files, better quality
# CAPTION_FONT=Inter          # any font installed on the server
# FONTS_DIR=                  # folder with extra .ttf/.otf fonts for captions
